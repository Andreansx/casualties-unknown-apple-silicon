# ── Game binaries - NEVER commit ─────────────────────────────
# Copyrighted game content + ~300 MB of binaries. Kept locally only.
CasualtiesUnknownDemo/
CasualtiesUnknown/
casualties-together/
# The co-op mod payload (NexusMods download) + the Windows BepInEx it ships with.
# Third-party binaries, no redistribution license - adapt the user's own copy in place.
KrokMP*/
BepInEx_win_x64_5/

# ── bepinex-applesilicon build output (source is committed, artifacts are rebuilt) ──
tools/bepinex-applesilicon/dist/
bin/
obj/
*.dylib
# ── Build output - the ported macOS .app is the deliverable ───
# Contains transplanted game data; don't push it to git.
build/
dist/
*.app/

# ── Unity transplant scratch ─────────────────────────────────
UnityEmptyProject/
EmptyMacBuild/

# ── Shader-harvest artifacts - derived from the game's shaders, NEVER commit ──
# The metallibs/AIR/DXBC are D3DMetal's runtime translation of the game's own shaders.
# Tooling (tools/harvest/*.m,*.sh,*.py) is fine to commit; the harvested binaries are not.
d3dm-harvest/
*.metallib
*.air
*.dxbc
libharvestshim.dylib

# Recovered MSL shader source (tools/rewrap/msl/*.metal) is game-derived content - the exact
# post-fx logic reconstructed from the game's shaders. Like the DXBC/AIR above, keep it LOCAL.
# The re-wrap TOOL (tools/rewrap/*.py) is committed; each user regenerates the MSL themselves.
tools/rewrap/msl/
*.metal
__pycache__/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# ── Editors / misc ───────────────────────────────────────────
.vscode/
.idea/
*.log
